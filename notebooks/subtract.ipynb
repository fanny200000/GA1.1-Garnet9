   "source": [
    "def distance_from_zero(a):\n",
    "    if a < 0:\n",
    "        return subtract(0,a)\n",
    "    else:\n",
    "        return a\n",
    "\n",
    "\n",
    "print(distance_from_zero(-8))    \n",
    "print(distance_from_zero(23))"
   ]
  }
